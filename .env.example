# Приложение
NODE_ENV=development
PORT=3000

# Redis: BullMQ и распределённый rate limiter
# Внутри Docker Compose хост переопределяется на `redis`.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Порт Redis на хосте (для интеграционных тестов); приложение в Docker ходит на 6379.
REDIS_HOST_PORT=6380

# PostgreSQL transactional outbox
# С хоста используйте localhost:5444.
# Внутри Docker Compose приложение автоматически подключается к postgres:5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5444
POSTGRES_DB=discord_limits
POSTGRES_USER=discord_app
POSTGRES_PASSWORD=discord_app_password
POSTGRES_POOL_SIZE=10

# Outbox publisher
# Интервал polling-страховки, размер пачки и lease для восстановления после сбоя.
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
OUTBOX_LEASE_MS=30000

# Discord Webhooks
# Реальные webhook URL храните только в .env и никогда не коммитьте.
DISCORD_WEBHOOK_A=
DISCORD_WEBHOOK_B=

# Доставка и rate limit
# Лимит применяется к каждому channelId независимо.
DISCORD_RATE_LIMIT_PER_SECOND=2
# Ключ канала живёт до последнего зарезервированного слота плюс этот запас.
DISCORD_RATE_LIMIT_CLEANUP_GRACE_MS=1000
DISCORD_WORKER_CONCURRENCY=10
DISCORD_REQUEST_TIMEOUT_MS=10000
# true: Discord возвращает тело созданного сообщения, включая message.id.
DISCORD_WAIT_FOR_MESSAGE=true
# В DLX уходит только HTTP 400. При 429 весь канал ждёт Discord Retry-After.
# Остальные ошибки повторяются с exponential backoff + jitter, не дольше DISCORD_RETRY_MAX_DELAY_MS.
# 0 - повторять до доставки; положительное число - уйти в DLX после стольких попыток.
DISCORD_RETRY_MAX_ATTEMPTS=0
DISCORD_RETRY_BASE_DELAY_MS=1000
DISCORD_RETRY_MAX_DELAY_MS=300000
