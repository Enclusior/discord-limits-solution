# Application
NODE_ENV=development
PORT=3000

# Redis / BullMQ / distributed rate limiter
# Inside Docker Compose the host is overridden to `redis`.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# PostgreSQL transactional outbox
# From the host machine use localhost:5444.
# Inside Docker Compose the app uses postgres:5432 automatically.
POSTGRES_HOST=localhost
POSTGRES_PORT=5444
POSTGRES_DB=discord_limits
POSTGRES_USER=discord_app
POSTGRES_PASSWORD=discord_app_password
POSTGRES_POOL_SIZE=10

# Outbox publisher
# Polling interval, batch size and lease for crash recovery.
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
OUTBOX_LEASE_MS=30000

# Discord Webhooks
# Keep real webhook URLs only in .env. Never commit them.
DISCORD_WEBHOOK_A=
DISCORD_WEBHOOK_B=

# Delivery and rate-limit policy
# The safety limit is applied independently per channelId.
DISCORD_RATE_LIMIT_PER_SECOND=2
DISCORD_WORKER_CONCURRENCY=10
DISCORD_REQUEST_TIMEOUT_MS=10000
# true makes Discord return the created message body, including message.id.
DISCORD_WAIT_FOR_MESSAGE=true
# 429 uses Discord Retry-After; backoff is for network errors and 5xx.
DISCORD_RETRY_MAX_ATTEMPTS=5
DISCORD_RETRY_BASE_DELAY_MS=1000
DISCORD_RETRY_MAX_DELAY_MS=30000

# NestJS log level
LOG_LEVEL=log
